# ─────────────────────────────────────────────────────────────────────────────
# Beacon environment configuration. Copy to `.env` and adjust as needed.
# NEVER commit a real `.env`. Secrets only ever live in env vars.
# ─────────────────────────────────────────────────────────────────────────────

# --- Database ---------------------------------------------------------------
# Runtime/app connection. MUST be a NON-superuser role so Postgres RLS is
# actually enforced (superusers and table owners bypass RLS).
DATABASE_URL="postgres://beacon_app:beacon_app@127.0.0.1:5432/beacon_dev"
# Admin connection used ONLY for migrations and seeding (bypasses RLS).
DATABASE_ADMIN_URL="postgres://postgres:postgres@127.0.0.1:5432/beacon_dev"
# Test database (used by `vitest`).
DATABASE_URL_TEST="postgres://beacon_app:beacon_app@127.0.0.1:5432/beacon_test"
DATABASE_ADMIN_URL_TEST="postgres://postgres:postgres@127.0.0.1:5432/beacon_test"

# --- Auth.js ----------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="dev-only-insecure-secret-change-me-0000000000000="
AUTH_URL="http://localhost:3000"

# --- Provider selection -----------------------------------------------------
# "mock" (default, zero external accounts) or "live" to use real providers.
SMS_PROVIDER="mock"
VOICE_PROVIDER="mock"
EMAIL_PROVIDER="mock"
LLM_PROVIDER="mock"
CALENDAR_PROVIDER="mock"

# --- Twilio (voice + SMS) — only needed when *_PROVIDER=live -----------------
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_MESSAGING_SERVICE_SID=""

# --- Resend (email) ---------------------------------------------------------
RESEND_API_KEY=""
RESEND_FROM_EMAIL="noreply@example.com"

# --- Anthropic (AI receptionist + qualification) ----------------------------
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-4-6"

# --- Google Calendar --------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Webhooks ---------------------------------------------------------------
# Shared secret used to verify inbound webhooks from the mock/live providers.
WEBHOOK_SIGNING_SECRET="dev-webhook-secret-change-me"

# --- App behavior -----------------------------------------------------------
# Quiet hours (local business time) during which automated SMS are deferred.
QUIET_HOURS_START="21"
QUIET_HOURS_END="8"
